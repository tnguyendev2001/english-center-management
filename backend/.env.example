SPRING_PROFILES_ACTIVE=prod
PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://HOST/DATABASE?sslmode=require
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

APP_ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_FRONTEND.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://YOUR_FRONTEND.vercel.app

JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MINUTES=240
JWT_ISSUER=school-management
JWT_AUDIENCE=school-management-web

APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=ChangeMeImmediately1

DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0
DB_CONNECTION_TIMEOUT=30000
DB_IDLE_TIMEOUT=300000

FRONTEND_URL=https://YOUR_FRONTEND.vercel.app
